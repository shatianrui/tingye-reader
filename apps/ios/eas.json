{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "local"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "credentialsSource": "local"
      }
    },
    "ui-verification": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "UI_VERIFICATION": "1"
      }
    }
  }
}
